{
  "name": "portfolio/tenant-pos",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "laravel/reverb": "*",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
