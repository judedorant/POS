APP_NAME=TenantPOS
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_GENERATED_KEY
APP_URL=https://pos.example.com
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pos
DB_USERNAME=pos_app
DB_PASSWORD=REPLACE_APP_PASSWORD
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/db-ca.crt
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SANCTUM_STATEFUL_DOMAINS=pos.example.com
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=pos
REVERB_APP_KEY=REPLACE_PUBLIC_RANDOM_KEY
REVERB_APP_SECRET=REPLACE_SECRET_RANDOM_KEY
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=pos.example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=https://pos.example.com
