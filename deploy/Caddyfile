{$POS_DOMAIN} {
    root * /app/public
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @private path /.env* /.git/* /vendor/* /storage/*
    respond @private 404
    @websocket path /app/*
    reverse_proxy @websocket reverb:8080
    @provider path /apps/*
    respond @provider 404
    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @dynamic not path /build/*
    header @dynamic Cache-Control "no-store"
    php_fastcgi app:9000
    file_server
}
